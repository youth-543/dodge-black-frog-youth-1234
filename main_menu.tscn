[gd_scene load_steps=6 format=3]

[ext_resource type="Script" path="res://menu.gd" id="1_menu"]

[sub_resource type="Shader" id="shader_bg"]
code = "shader_type canvas_item;
void fragment() {
	vec2 uv = UV;
	vec3 base_col = vec3(0.035, 0.045, 0.085);
	vec3 glow_col = vec3(0.075, 0.105, 0.185);
	float d = distance(uv, vec2(0.5, 0.42));
	vec3 col = mix(glow_col, base_col, smoothstep(0.05, 0.75, d));
	vec2 g = abs(fract(uv * vec2(48.0, 27.0)) - 0.5);
	float grid = smoothstep(0.46, 0.5, max(g.x, g.y));
	col += vec3(0.10, 0.16, 0.28) * grid * 0.18;
	COLOR = vec4(col, 1.0);
}"

[sub_resource type="ShaderMaterial" id="mat_bg"]
shader = SubResource("shader_bg")

